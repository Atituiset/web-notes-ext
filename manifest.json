{
  "manifest_version": 3,
  "name": "Markpilot — Web Notes to Obsidian & AI",
  "version": "0.2.1",
  "description": "划词笔记 → 本地 Obsidian → LLM 实时问答，带跨会话长期记忆",
  "permissions": ["storage", "sidePanel", "activeTab", "scripting"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://api.deepseek.com/*",
    "https://open.bigmodel.cn/*",
    "https://api.moonshot.cn/*",
    "https://dashscope.aliyuncs.com/*",
    "https://openrouter.ai/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://opencode.ai/*"
  ],
  "background": {
    "service_worker": "background/sw.js"
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "options_page": "options/options.html",
  "action": {
    "default_title": "Markpilot"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/extract.js", "content/annotator.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {}
}
