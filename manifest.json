{
  "manifest_version": 3,
  "name": "Markpilot — Web Notes to Obsidian & AI",
  "version": "0.1.0",
  "description": "划词笔记 → 本地 Obsidian → LLM 实时问答",
  "permissions": ["storage", "sidePanel", "activeTab", "scripting"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background/sw.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/panel/panel.html"
  },
  "options_page": "src/options/options.html",
  "action": {
    "default_title": "Markpilot"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/extract.js", "src/content/annotator.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {}
}
