{
  "name": "markpilot",
  "version": "0.4.9",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node build.mjs",
    "package": "npm run build && node package.mjs",
    "watch": "node build.mjs --watch",
    "test": "node tests/run-unit.mjs",
    "check": "tsc --noEmit && tsc --noEmit -p packages/vscode-ext/tsconfig.json",
    "eval:memory": "node tests/eval-memory.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@vscode/vsce": "^3.9.2",
    "@xenova/transformers": "^2.17.2",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
