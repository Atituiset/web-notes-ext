{
  "name": "@markpilot/vscode-ext",
  "displayName": "Markpilot — Code Notes to Obsidian & AI",
  "description": "Code notes & highlights synced to an Obsidian vault, BYOK LLM Q&A with long-term memory, and streaming selection translation.",
  "version": "0.5.1",
  "publisher": "atituiset",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:markpilot.setup",
    "onCommand:markpilot.note",
    "onCommand:markpilot.ask",
    "onCommand:markpilot.translate",
    "onCommand:markpilot.exportNotes",
    "onCommand:markpilot.setApiKey",
    "onView:markpilot.chat"
  ],
  "contributes": {
    "commands": [
      {
        "command": "markpilot.setup",
        "title": "快速配置（平台 / API Key / 模型）",
        "category": "Markpilot"
      },
      {
        "command": "markpilot.note",
        "title": "Add Note on Selection",
        "category": "Markpilot"
      },
      {
        "command": "markpilot.ask",
        "title": "Ask AI about Selection",
        "category": "Markpilot"
      },
      {
        "command": "markpilot.translate",
        "title": "Translate Selection",
        "category": "Markpilot"
      },
      {
        "command": "markpilot.exportNotes",
        "title": "Export File Notes to Obsidian",
        "category": "Markpilot"
      },
      {
        "command": "markpilot.setApiKey",
        "title": "Set LLM API Key",
        "category": "Markpilot"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "markpilot.note",
          "when": "editorHasSelection",
          "group": "markpilot@1"
        },
        {
          "command": "markpilot.ask",
          "when": "editorHasSelection",
          "group": "markpilot@2"
        },
        {
          "command": "markpilot.translate",
          "when": "editorHasSelection",
          "group": "markpilot@3"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "markpilot",
          "title": "Markpilot",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "markpilot": [
        {
          "id": "markpilot.chat",
          "type": "webview",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "Markpilot",
      "properties": {
        "markpilot.provider": {
          "type": "string",
          "default": "openai-compatible",
          "enum": [
            "opencode",
            "openai-compatible",
            "ollama",
            "openrouter",
            "anthropic",
            "deepseek",
            "zhipu",
            "moonshot",
            "qwen"
          ],
          "enumDescriptions": [
            "OpenCode 免费模型 (零配置)",
            "OpenAI 兼容 (自定义 baseUrl)",
            "Ollama 本地 (localhost:11434)",
            "OpenRouter",
            "Anthropic",
            "DeepSeek 深度求索",
            "智谱 GLM",
            "月之暗面 Kimi",
            "阿里通义千问 (兼容模式)"
          ],
          "description": "LLM 平台（与 Chrome 版同一套 PROVIDERS 预设；推荐用「Markpilot: 快速配置」向导）"
        },
        "markpilot.model": {
          "type": "string",
          "default": "",
          "description": "模型 ID（如 deepseek-chat、glm-4-flash）"
        },
        "markpilot.baseUrl": {
          "type": "string",
          "default": "",
          "description": "自定义 Base URL（仅 openai-compatible 需要；其余 provider 走预设端点）"
        },
        "markpilot.vaultPath": {
          "type": "string",
          "default": "",
          "description": "Obsidian vault 目录的绝对路径（长期记忆/用户画像/笔记导出的落盘位置；留空则记忆功能停用）"
        },
        "markpilot.memoryInject": {
          "type": "boolean",
          "default": true,
          "description": "提问时注入长期记忆（需配置 vaultPath）"
        },
        "markpilot.exportAiQA": {
          "type": "boolean",
          "default": false,
          "description": "导出笔记到 Obsidian 时包含 AI 问答记录"
        },
        "markpilot.semanticRecall": {
          "type": "string",
          "enum": [
            "off",
            "local"
          ],
          "default": "off",
          "description": "语义召回通道：local = 端侧 MiniLM（需可解析 @xenova/transformers，首次运行下载模型）"
        }
      }
    }
  },
  "scripts": {
    "compile": "node build.mjs && tsc --noEmit -p tsconfig.json",
    "watch": "node build.mjs --watch",
    "package": "node scripts/vsix.mjs",
    "test:vscode": "node scripts/test.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.1",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "mocha": "^12.0.0"
  }
}
