{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vscode"]
  },
  "include": ["src/**/*.ts", "../core/src/**/*.ts"]
}
