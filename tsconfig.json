{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "types": ["chrome"]
  },
  "include": ["packages/chrome-ext/src/**/*.ts", "packages/chrome-ext/src/**/*.js", "packages/core/src/**/*.ts", "packages/core/src/**/*.js"],
  "exclude": ["packages/chrome-ext/src/background/sw.ts", "packages/vscode-ext"]
}
